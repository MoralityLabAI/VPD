{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://small-control-harness.local/schemas/run_contract.schema.json",
  "title": "RunContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "contract_id",
    "subject",
    "objective",
    "action_scope",
    "resources",
    "invariants",
    "evidence",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "version": {"const": "sch.run-contract.v1"},
    "contract_id": {"type": "string", "minLength": 8},
    "subject": {"type": "string", "minLength": 1},
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "success_predicates"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "success_predicates": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "action_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "verb"],
        "properties": {
          "tool": {"type": "string", "minLength": 1},
          "verb": {"type": "string", "minLength": 1},
          "constraints": {"type": "object"}
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_calls"],
      "properties": {
        "max_calls": {"type": "integer", "minimum": 0},
        "max_notional": {"type": "number", "minimum": 0},
        "max_fee": {"type": "number", "minimum": 0},
        "max_compute_seconds": {"type": "number", "minimum": 0},
        "network_allowlist": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "writable_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": {"enum": ["artifact", "command", "state_predicate", "receipt"]},
          "value": {"type": "string", "minLength": 1}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "metadata": {"type": "object"}
  }
}
