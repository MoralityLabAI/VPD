# Retain source for the remote executor, not its environments or launch records.
/primelab/**
!/primelab/hrm_base_conformance_v1/
!/primelab/hrm_base_conformance_v1/remote_conformance.py
!/primelab/hrm_base_conformance_v1/requirements.txt
!/primelab/hrm_base_conformance_v1/run_remote.sh
!/primelab/hrm_base_conformance_v1/launch_prime.sh

# Publish small deterministic reports/specifications and the dataset indices.
# Model weights, raw captures, cloud receipts and downloaded corpora stay local.
/artifacts/*
!/artifacts/vpd_*/
/artifacts/vpd_*/**
!/artifacts/vpd_*/*.json
!/artifacts/vpd_*/*.md
!/artifacts/nanbeige_reasoning/
