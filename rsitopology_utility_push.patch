+"""Offline uncertainty and regret for a frozen finite VPD candidate catalog."""
+
+from __future__ import annotations
+
+import math
+from collections.abc import Mapping, Sequence
+from typing import Any
+
+
+def _mean_interval(
+    values: Sequence[float | None] | None, n: int, radius: float, rho: float
+) -> dict[str, Any]:
+    if values is None:
+        return {"mean": None, "interval": [0.0, 1.0], "missing_blocks": n}
+    if len(values) != n:
+        raise ValueError("every score column must match the declared block IDs")
+    for value in values:
+        if value is not None and (
+            isinstance(value, bool)
+            or not isinstance(value, (int, float))
+            or not math.isfinite(value)
+            or not 0 <= value <= 1
+        ):
+            raise ValueError("scores must be finite numbers in [0,1] or None")
+    missing = sum(value is None for value in values)
+    if missing:
+        return {"mean": None, "interval": [0.0, 1.0], "missing_blocks": missing}
+    score = math.fsum(values) / n
+    return {
+        "mean": score,
+        "interval": [max(0.0, score - radius - rho), min(1.0, score + radius + rho)],
+        "missing_blocks": 0,
+    }
+
+
+def _difference(left: Sequence[float], right: Sequence[float], *, same: bool = False) -> list[float]:
+    if same:
+        return [0.0, 0.0]
+    return [left[0] - right[1], left[1] - right[0]]
+
+
+def evaluate_selection(
+    *,
+    block_ids: Sequence[str],
+    utility: Mapping[str, Sequence[float | None] | None],
+    benign: Mapping[str, Sequence[float | None] | None],
+    selected: str,
+    baseline: str,
+    alpha: float = 0.05,
+    error_radius: float = 0.0,
+) -> dict[str, Any]:
+    """Evaluate one already-frozen choice while retaining every challenger."""
+    if not block_ids or any(not isinstance(item, str) or not item for item in block_ids):
+        raise ValueError("nonempty string family-block IDs required")
+    if len(set(block_ids)) != len(block_ids):
+        raise ValueError("duplicate family blocks are not independent observations")
+    if not utility or list(utility) != list(benign):
+        raise ValueError("task and benign tables must retain the same ordered catalog")
+    if selected not in utility or baseline not in utility:
+        raise ValueError("selected and baseline candidates must be in the catalog")
+    if not math.isfinite(alpha) or not 0 < alpha < 1:
+        raise ValueError("alpha must be in (0,1)")
+    if not math.isfinite(error_radius) or not 0 <= error_radius <= 1:
+        raise ValueError("error radius must be finite and in [0,1]")
+
+    n, k = len(block_ids), len(utility)
+    radius = math.sqrt(math.log(4 * k / alpha) / (2 * n))
+    intervals = {
+        name: {
+            "utility": _mean_interval(utility[name], n, radius, error_radius),
+            "benign": _mean_interval(benign[name], n, radius, error_radius),
+        }
+        for name in utility
+    }
+    chosen = intervals[selected]
+    unchanged = intervals[baseline]
+    challengers = []
+    for name, row in intervals.items():
+        if name == selected:
+            continue
+        challengers.append(
+            {
+                "id": name,
+                "advantage_interval": _difference(
+                    row["utility"]["interval"], chosen["utility"]["interval"]
+                ),
+            }
+        )
+    regret_lower = max([0.0] + [row["advantage_interval"][0] for row in challengers])
+    regret_upper = max([0.0] + [row["advantage_interval"][1] for row in challengers])
+    means = {name: row["utility"]["mean"] for name, row in intervals.items()}
+    measured = {name: value for name, value in means.items() if value is not None}
+    all_measured = len(measured) == k
+    return {
+        "scope": "conditional_within_comparison_not_empirical_admission",
+        "selected": selected,
+        "baseline": baseline,
+        "catalog": list(utility),
+        "independent_family_blocks_assumed": n,
+        "alpha": alpha,
+        "simultaneous_mean_count": 2 * k,
+        "hoeffding_radius": radius,
+        "error_radius": error_radius,
+        "intervals": intervals,
+        "baseline_improvement": {
+            "point": (
+                None
+                if means[selected] is None or means[baseline] is None
+                else means[selected] - means[baseline]
+            ),
+            "interval": _difference(
+                chosen["utility"]["interval"],
+                unchanged["utility"]["interval"],
+                same=selected == baseline,
+            ),
+        },
+        "regret": {
+            "point": max(measured.values()) - means[selected] if all_measured else None,
+            "interval": [regret_lower, regret_upper],
+            "observed_best_candidate": max(measured, key=measured.get) if measured else None,
+            "possible_missed_challengers": [
+                row["id"] for row in challengers if row["advantage_interval"][1] > 0
+            ],
+            "lower_bound_attainers": (
+                [row["id"] for row in challengers if row["advantage_interval"][0] == regret_lower]
+                if regret_lower > 0
+                else [selected]
+            ),
+            "upper_bound_attainers": (
+                [row["id"] for row in challengers if row["advantage_interval"][1] == regret_upper]
+                if regret_upper > 0
+                else [selected]
+            ),
+        },
+        "benign_loss": {
+            "interval": _difference(
+                unchanged["benign"]["interval"],
+                chosen["benign"]["interval"],
+                same=selected == baseline,
+            )
+        },
+    }
+
+
+def compare_calibration_selectors(
+    *,
+    block_ids: Sequence[str],
+    utility: Mapping[str, Sequence[float | None] | None],
+    benign: Mapping[str, Sequence[float | None] | None],
+    geometry_scores: Mapping[str, float],
+    baseline: str,
+    maximum_benign_loss: float = 0.01,
+    alpha: float = 0.05,
+) -> dict[str, Any]:
+    """Choose three selectors on calibration data; final evaluation is separate."""
+    catalog = list(utility)
+    if list(benign) != catalog or list(geometry_scores) != catalog:
+        raise ValueError("all selector inputs must use the same ordered catalog")
+    if baseline not in catalog:
+        raise ValueError("baseline must be in the catalog")
+    if not math.isfinite(maximum_benign_loss) or maximum_benign_loss < 0:
+        raise ValueError("maximum benign loss must be finite and nonnegative")
+    if any(
+        isinstance(score, bool) or not isinstance(score, (int, float)) or not math.isfinite(score)
+        for score in geometry_scores.values()
+    ):
+        raise ValueError("geometry scores must be finite numbers")
+
+    reports = {
+        name: evaluate_selection(
+            block_ids=block_ids,
+            utility=utility,
+            benign=benign,
+            selected=name,
+            baseline=baseline,
+            alpha=alpha,
+        )
+        for name in catalog
+    }
+    means = {name: reports[name]["intervals"][name]["utility"]["mean"] for name in catalog}
+    if any(value is None for value in means.values()):
+        global_choice = baseline
+    else:
+        global_choice = max(catalog, key=lambda name: (means[name], name == baseline, -catalog.index(name)))
+    geometric_choice = max(
+        catalog,
+        key=lambda name: (geometry_scores[name], name == baseline, -catalog.index(name)),
+    )
+    eligible = [
+        name
+        for name in catalog
+        if reports[name]["benign_loss"]["interval"][1] <= maximum_benign_loss
+    ]
+    if eligible:
+        interval_choice = min(
+            eligible,
+            key=lambda name: (
+                reports[name]["regret"]["interval"][1],
+                -reports[name]["intervals"][name]["utility"]["interval"][0],
+                name != baseline,
+                catalog.index(name),
+            ),
+        )
+    else:
+        interval_choice = baseline
+    return {
+        "catalog": catalog,
+        "selected": {
+            "global_utility": global_choice,
+            "geometric": geometric_choice,
+            "interval_aware": interval_choice,
+        },
+        "candidate_reports": reports,
+        "final_outcomes_used": False,
+    }
+
+
+def validate_equal_fit_budgets(candidates: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
+    """Fail closed unless the fields that define rank and fit opportunity match."""
+    required = (
+        "candidate_id",
+        "total_rank",
+        "fit_model_call_cap",
+        "fit_flop_cap",
+        "fit_storage_byte_cap",
+        "maximum_edited_coordinates",
+    )
+    if not candidates:
+        raise ValueError("at least one candidate is required")
+    ids = []
+    vectors = []
+    for candidate in candidates:
+        missing = [field for field in required if field not in candidate]
+        if missing:
+            raise ValueError(f"candidate missing budget fields: {missing}")
+        candidate_id = candidate["candidate_id"]
+        if not isinstance(candidate_id, str) or not candidate_id:
+            raise ValueError("candidate_id must be a nonempty string")
+        ids.append(candidate_id)
+        vector = []
+        for field in required[1:]:
+            value = candidate[field]
+            if isinstance(value, bool) or not isinstance(value, (int, float)) or value < 0:
+                raise ValueError(f"{field} must be a nonnegative number")
+            vector.append(value)
+        vectors.append(tuple(vector))
+    if len(set(ids)) != len(ids):
+        raise ValueError("candidate IDs must be unique")
+    if len(set(vectors)) != 1:
+        raise ValueError("candidate rank or fit budgets differ")
+    return {"status": "pass", "candidate_count": len(ids), "budget_vector": list(vectors[0])}
