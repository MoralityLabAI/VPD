@@ -0,0 +1,121 @@
+from __future__ import annotations
+
+import pytest
+
+from rsi_topology.utility_selection import (
+    compare_calibration_selectors,
+    evaluate_selection,
+    validate_equal_fit_budgets,
+)
+
+
+def columns(values, n=10000):
+    return {name: None if value is None else [value] * n for name, value in values.items()}
+
+
+def test_improvement_and_regret_are_distinct():
+    utility = columns({"baseline": 0.2, "selected": 0.5, "missed": 0.9})
+    result = evaluate_selection(
+        block_ids=[str(i) for i in range(10000)],
+        utility=utility,
+        benign=columns({"baseline": 0.9, "selected": 0.9, "missed": 0.9}),
+        selected="selected",
+        baseline="baseline",
+    )
+    assert result["baseline_improvement"]["interval"][0] > 0
+    assert result["regret"]["point"] == pytest.approx(0.4)
+    assert result["regret"]["interval"][0] > 0.3
+    assert result["regret"]["upper_bound_attainers"] == ["missed"]
+
+
+def test_missing_challenger_remains_in_envelope():
+    result = evaluate_selection(
+        block_ids=[str(i) for i in range(10000)],
+        utility=columns({"baseline": 0.3, "selected": 0.6, "unmeasured": None}),
+        benign=columns({"baseline": 0.9, "selected": 0.9, "unmeasured": None}),
+        selected="selected",
+        baseline="baseline",
+    )
+    assert result["intervals"]["unmeasured"]["utility"]["interval"] == [0, 1]
+    assert result["regret"]["point"] is None
+    assert "unmeasured" in result["regret"]["possible_missed_challengers"]
+
+
+def test_error_radius_widens_challenger_envelope_and_self_cancels():
+    clean = evaluate_selection(
+        block_ids=[str(i) for i in range(10000)],
+        utility=columns({"baseline": 0.4, "selected": 0.6}),
+        benign=columns({"baseline": 0.9, "selected": 0.9}),
+        selected="selected",
+        baseline="baseline",
+    )
+    stressed = evaluate_selection(
+        block_ids=[str(i) for i in range(10000)],
+        utility=columns({"baseline": 0.4, "selected": 0.6}),
+        benign=columns({"baseline": 0.9, "selected": 0.9}),
+        selected="selected",
+        baseline="baseline",
+        error_radius=0.05,
+    )
+    assert stressed["regret"]["interval"][1] >= clean["regret"]["interval"][1]
+    baseline = evaluate_selection(
+        block_ids=["a", "b"],
+        utility={"baseline": [0.4, 0.5]},
+        benign={"baseline": [0.9, 0.9]},
+        selected="baseline",
