+            zla_i = zl_a_m[bi : bi + 1]
+            zhb_i = zh_b_m[bi : bi + 1]
+            zlb_i = zl_b_m[bi : bi + 1]
+            s_i = seeds[bi]
+
+            h_swap, cert = trm_manifold_swap(zha_i, zhb_i, model.lm_head.weight, board_start=b_start)
