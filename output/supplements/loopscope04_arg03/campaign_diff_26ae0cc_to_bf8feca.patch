+def test_causal_gramian_validation_high_beats_low():
+    class AsymmetricDelayedMap:
+        def __init__(self):
+            self.lm_head = torch.nn.Linear(8, 2, bias=False)
+            with torch.no_grad():
+                self.lm_head.weight.zero_()
