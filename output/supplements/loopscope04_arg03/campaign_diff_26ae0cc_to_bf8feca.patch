+def generate_diverse_solution(rng: random.Random) -> str:
+    """Synthesize a genuinely random valid 9x9 Sudoku solution via randomized MRV backtracking."""
+    grid = [0] * 81
+    rmask, cmask, bmask = [0] * 9, [0] * 9, [0] * 9
+
+    def solve() -> bool:
+        best = -1
+        best_mask = 0
+        best_cnt = 10
+        for i, v in enumerate(grid):
+            if v:
+                continue
+            r, c = divmod(i, 9)
+            b = (r // 3) * 3 + c // 3
+            mask = FULL & ~(rmask[r] | cmask[c] | bmask[b])
+            n = mask.bit_count()
+            if n == 0:
+                return False
+            if n < best_cnt:
+                best, best_mask, best_cnt = i, mask, n
+                if n == 1:
+                    break
+        if best < 0:
+            return True
+        r, c = divmod(best, 9)
+        b = (r // 3) * 3 + c // 3
+        digits = [d for d in range(1, 10) if (best_mask & (1 << (d - 1)))]
+        rng.shuffle(digits)
+        for d in digits:
+            bit = 1 << (d - 1)
+            grid[best] = d
+            rmask[r] |= bit
+            cmask[c] |= bit
+            bmask[b] |= bit
+            if solve():
+                return True
+            rmask[r] ^= bit
+            cmask[c] ^= bit
+            bmask[b] ^= bit
+            grid[best] = 0
+        return False
+
+    if not solve():
+        raise RuntimeError("empty Sudoku failed to solve")
+    return "".join(str(v) for v in grid)
