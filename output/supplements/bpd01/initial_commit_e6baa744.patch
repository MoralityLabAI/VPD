+def test_gate_b1_stationary_tied_matches_unrolled_at_one_over_T_components() -> None:
+    res = run_benchmark(
+        n_passes=4,
+        c_shared=4,
+        n_steps=45,
+        batch_size=16,
+        seq_len=6,
+        device="cpu",
+        seed=7,
+    )
+    assert res["compression_ratio"] == 4.0
+    assert res["gate_b1_passed"] is True
